{
  "name": "PINNeAPPle",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // Same commands a contributor runs on their own machine, so the container cannot drift from CONTRIBUTING.md:
  // `make setup` creates .venv and installs the package with its test extras (issue #50). The CPU wheel of torch
  // is installed first, because the default one on Linux is the CUDA build and is several GB.
  "postCreateCommand": "make setup TORCH_INDEX=https://download.pytorch.org/whl/cpu",

  // The fast suite trains small networks and the full suite trains bigger ones; 2 cores and 8 GB runs `make test`
  // in about a minute, 4 GB does not.
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },

  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "editor.rulers": [100],
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    }
  }
}
