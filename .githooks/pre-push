#!/bin/bash
# GitHub Actions has been unavailable (billing) since 2026-11-05, so the checks a reviewer would read from the checks tab
# have to pass here, on the machine that pushes. `git push --no-verify` skips it; `STRICT=1` also blocks on the
# repository-wide checks; `PY=...` picks the interpreter (the gate finds one that can import pytest when it is unset).
set -u
cd "$(git rev-parse --show-toplevel)"
exec ./scripts/local_gate.sh
