pinneapple_files/
examples/_out/
examples/_runs*/
examples/results_chassis/
examples/use_cases/*/outputs/
examples/geometry/outputs/
# MeshGraphNet examples: downloaded data and run outputs
examples/meshgraphnet/_data/
examples/meshgraphnet/_out/*.log

# ASME forms are copyrighted: keep users' copies out of the repository
apps/deploy/forms/*.pdf

# studio examples: keep the renders and the coefficients, not the cases, models and viewers they write
examples/studio/_out/**
!examples/studio/_out/**/
!examples/studio/_out/**/*.jpg
!examples/studio/_out/**/coefficients_*.json
examples/studio/_out/**/viewer/
examples/studio/_out/**/case_*/

# PINNeAPPle Lab database: metadata, metrics, validation, figures and dataset cards are versioned;
# arrays, dataset shards and the SQLite index (rebuilt with `python -m pinneapple_lab reindex`) are not
!lab/runs/
lab/index.sqlite
lab/_worktree/
lab/_exports/
lab/_cases/
lab/_external/
lab/**/outputs/scene.glb
lab/**/*.npy
lab/**/*.npz
lab/**/samples.jsonl
lab/**/metrics_log.jsonl
examples/modelica/_out/
examples/free_surface/_out/
examples/geomechanics/_out/
examples/openfoam_campaign/_out/
examples/lbm/_out/
examples/geometry_library/_out/
dist/geometries/

# brick experiment: heavy outputs (viewer copies three.js, frames)
