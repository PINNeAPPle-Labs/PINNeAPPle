examples/bricks/_out/turntable_frames/
examples/flow_studio/_runs/

examples/flight_dynamics/_out/
examples/flight_dynamics/_*.log
examples/autolab_rover/_out/
examples/freecad_openfoam/_work/

# Ahmed-body end-to-end study: OpenFOAM runs and fields (results/ is committed)
examples/end_to_end/ahmed_body/_runs/
examples/end_to_end/ahmed_body/results/cad/*.stl
# Generated files: built where they are used, never committed (AGENTS.md, "Generated files")
data/web/hub/index.json
docs/flow_studio/COVERAGE.md
docs/flow_studio/EXAMPLES_AS_FLOWS.md
# compact-range private runs (examples/use_cases/antennas/compact_range_2ghz.py --private): client geometry and
# results stay outside the repository; these names are refused here as a second guard
*_private.json
*.private.json
private_compact_range*/
# resumable checkpoints of the compact-range design study (reflector.design.run_design_study)
examples/use_cases/antennas/results/*/checkpoints/
examples/use_cases/antennas/outputs/

# Mapa PT: generated by docs/pt/_mapa/inventario.py, never committed
docs/pt/_mapa/inventario.json
docs/pt/mapa_completo.pdf
docs/pt/_mapa/exclude.local.txt
# Studio coverage table: generated by python -m pinneapple_studio coverage
docs/studio/COVERAGE.md

