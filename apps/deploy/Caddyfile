{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	# TLS 1.2+ with Caddy's modern cipher suites; certificates from Let's Encrypt (ACME_EMAIL)
	tls {
		protocols tls1.2 tls1.3
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), geolocation=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}
	# JSON access log on the caddy_data volume, rotated (Authorization and cookies are redacted by Caddy);
	# fail2ban reads it for repeated 401/429 (docs/security/server.md)
	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

{$HSS_DOMAIN} {
	import common
	request_body {
		max_size 1MB
	}
	reverse_proxy heatsink:8080 {
		transport http {
			read_timeout 120s
		}
	}
}

