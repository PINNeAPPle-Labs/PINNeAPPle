# Copy to apps/flow_studio/.env (docker compose) or to the folder you start `python -m pinneapple_flow studio` from.

# --- where things are stored -----------------------------------------------------------------------------------
# PINNEAPPLE_FLOW_HOME=~/.pinneapple_flow           # SQLite store, run folders, Lab
# PINNEAPPLE_FLOW_DB_URL=postgresql+psycopg://flow:change-me@postgres:5432/flow
# PINNEAPPLE_FLOW_DATA=~/.pinneapple_flow/data      # the only folder data-ingest nodes read files from

# --- LLM planner (optional; the heuristic planner always works offline) -----------------------------------------
# local Ollama (docker compose --profile llm: then `docker compose exec ollama ollama pull llama3.1`)
# PINNEAPPLE_FLOW_LLM_PROVIDER=ollama
# PINNEAPPLE_FLOW_LLM_MODEL=llama3.1
# PINNEAPPLE_FLOW_LLM_BASE_URL=http://ollama:11434
#
# any OpenAI-compatible server (vLLM, LM Studio, llama.cpp, a model you host)
# PINNEAPPLE_FLOW_LLM_PROVIDER=openai_compatible
# PINNEAPPLE_FLOW_LLM_BASE_URL=http://localhost:8000/v1
# PINNEAPPLE_FLOW_LLM_MODEL=my-model
# PINNEAPPLE_FLOW_LLM_API_KEY=
#
# hosted
# PINNEAPPLE_FLOW_LLM_PROVIDER=anthropic           # or openai
# PINNEAPPLE_FLOW_LLM_MODEL=
# ANTHROPIC_API_KEY=                               # or OPENAI_API_KEY / PINNEAPPLE_FLOW_LLM_API_KEY

# --- server -----------------------------------------------------------------------------------------------------
# PINNEAPPLE_FLOW_HOST=127.0.0.1
# PINNEAPPLE_FLOW_PORT=8765
# Login when the server is reachable from other machines (appkit; hash with: python -m pinneapple_security hash-password)
# FLOW_USER=
# FLOW_PASSWORD_HASH=
# FLOW_RATE_LIMIT=120/min
# FLOW_MAX_RUNS=1
