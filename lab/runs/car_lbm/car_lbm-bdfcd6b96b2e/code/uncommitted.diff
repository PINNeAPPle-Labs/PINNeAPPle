+SHOWCASE_TOKENS = (("interstellar", 9), ("beauty", 8), ("render", 6), ("flight", 6), ("twin", 5), ("streamlines", 5),
+                   ("wake", 3), ("cp", 3), ("vorticity", 3), (".gif", 4))
+
