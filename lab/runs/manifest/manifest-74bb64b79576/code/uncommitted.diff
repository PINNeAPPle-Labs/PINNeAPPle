+def from_results(folder: str, rules=None) -> Manifest:
+    """The folder's manifest (:func:`manifest_from_dir`) with the metrics and checks its committed results hold,
+    extracted by ``rules`` (default: the folder's entry in ``pinneapple_lab.results_rules.RESULTS_RULES``). Only
+    values in the files are used; a check is a verdict the study recorded, its own check records, or a value
+    against the threshold the study's own test applies (cited)."""
+    from .results_rules import RESULTS_RULES, extract
+    rel = os.path.relpath(os.path.abspath(folder), REPO)
+    rules = RESULTS_RULES.get(rel, []) if rules is None else rules
+    m = manifest_from_dir(folder)
+    m.metrics, m.checks = extract(folder, rules)
+    m.provenance["source"] = "results"
+    return m
 
 
