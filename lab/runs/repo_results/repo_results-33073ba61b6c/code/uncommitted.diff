+            ctx.metric(f"{mode}_{key}_mean_abs_pct", e["mean_abs_pct"])
+            ctx.metric(f"{mode}_{key}_p95_abs_pct", e["p95_abs_pct"])
+            ctx.metric(f"{mode}_{key}_within_5pct", e["pct_within_5pct"])
