{
 "schema": "pinneapple-flow/1",
 "id": "example-em-prius-drive",
 "name": "Prius drive: flux map, envelope, efficiency, WLTC (11)",
 "description": "FEA flux map of the Prius motor, torque-speed envelope (MTPA + flux weakening), efficiency map and battery energy over the WLTC class 3b cycle (examples/electrodynamics/11_prius_drive.py).",
 "nodes": [
  {
   "id": "fluxmap",
   "type": "em.prius_flux_map",
   "params": {},
   "label": "Flux map (FEA)",
   "position": {
    "x": 40.0,
    "y": 40.0
   }
  },
  {
   "id": "drive",
   "type": "em.prius_drive",
   "params": {},
   "label": "Drive + WLTC",
   "position": {
    "x": 330.0,
    "y": 40.0
   }
  },
  {
   "id": "compare",
   "type": "examples.compare",
   "params": {
    "example": "electrodynamics",
    "comparisons": [
     {
      "flow": "drive.assumptions.R_phase_ohm",
      "ref": "results/11_prius_drive.json:assumptions.R_phase_ohm"
     },
     {
      "flow": "drive.efficiency_map.peak_efficiency",
      "ref": "results/11_prius_drive.json:efficiency_map.peak_efficiency"
     },
     {
      "flow": "drive.wltc_class3b.battery_Wh_per_km",
      "ref": "results/11_prius_drive.json:wltc_class3b.battery_Wh_per_km"
     },
     {
      "flow": "drive.wltc_class3b.battery_J",
      "ref": "results/11_prius_drive.json:wltc_class3b.battery_J"
     },
     {
      "flow": "drive.wltc_class3b.regenerated_J",
      "ref": "results/11_prius_drive.json:wltc_class3b.regenerated_J"
     },
     {
      "flow": "drive.envelope.torque_0rpm_Nm",
      "ref": "results/11_prius_drive.json:envelope.torque_Nm.0"
     },
     {
      "flow": "drive.envelope.torque_3000rpm_Nm",
      "ref": "results/11_prius_drive.json:envelope.torque_Nm.12"
     },
     {
      "flow": "drive.envelope.torque_6000rpm_Nm",
      "ref": "results/11_prius_drive.json:envelope.torque_Nm.24"
     }
    ],
    "tolerance_source": "deterministic FEA: the same library code and inputs; 1e-6 relative covers BLAS / platform rounding"
   },
   "label": "Same numbers as examples/electrodynamics",
   "position": {
    "x": 620.0,
    "y": 40.0
   }
  }
 ],
 "edges": [
  {
   "source": "fluxmap",
   "source_port": "flux_map",
   "target": "drive",
   "target_port": "flux_map",
   "id": "fluxmap.flux_map->drive.flux_map"
  },
  {
   "source": "drive",
   "source_port": "metrics",
   "target": "compare",
   "target_port": "metrics",
   "id": "drive.metrics->compare.metrics"
  }
 ],
 "meta": {
  "kind": "example",
  "example": "electrodynamics",
  "domain": "electromagnetics",
  "scripts": [
   "11_prius_drive.py"
  ],
  "quick": {
   "fluxmap": {
    "source": "example"
   }
  }
 }
}
