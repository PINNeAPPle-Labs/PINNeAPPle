      "ref": "results/17_prius_tolerances.json:outputs.torque_Nm.mean"
     },
     {
      "flow": "tol.outputs.torque_Nm.std",
      "ref": "results/17_prius_tolerances.json:outputs.torque_Nm.std"
     },
     {
      "flow": "tol.outputs.torque_Nm.src_r2",
      "ref": "results/17_prius_tolerances.json:outputs.torque_Nm.src_r2"
     },
     {
      "flow": "tol.outputs.ripple.mean",
      "ref": "results/17_prius_tolerances.json:outputs.ripple.mean"
     },
     {
      "flow": "tol.p_within_spec_joint",
      "ref": "results/17_prius_tolerances.json:p_within_spec_joint"
     }
    ],
    "tolerance_source": "deterministic FEA: the same library code and inputs; 1e-6 relative covers BLAS / platform rounding (seeded sampling)"
