{
 "schema": "pinneapple-flow/1",
 "id": "example.getting_started.03_heat_diffusion_1d",
 "name": "Heat diffusion 1-D: PINNs for three diffusivities",
 "description": "examples/getting_started/03_heat_diffusion_1d.py: u_t = alpha u_xx on [0, 1] x [0, 1], u(x, 0) = sin(pi x), u = 0 at the ends, for alpha = 0.01, 0.1, 0.5; each PINN (3 x 64 tanh, 8000 Adam steps at lr 1e-3, 4096 collocation points, seed 7 as in the script) against u = sin(pi x) exp(-alpha pi^2 t) on a 60 x 60 grid. The script trains its own torch loop with a hard x(1 - x) boundary factor; here train.pinn (pinneapple_physics.symbolic_pde) enforces the ends as a penalty. Nothing committed: the script prints the relative L2 per alpha.",
 "nodes": [
  {
   "id": "geo",
   "type": "geometry.domain",
   "params": {
    "dimension": 1,
    "x_range": [
     0.0,
     1.0
    ],
    "y_range": [
     0,
     1
    ],
    "z_range": [
     0,
     1
    ],
    "time_dependent": true,
    "t_range": [
     0.0,
     1.0
    ]
   },
   "label": "rod x time",
   "position": {
    "x": 40.0,
    "y": 40.0
   }
  },
  {
   "id": "mesh",
   "type": "geometry.mesh",
   "params": {
    "n": 60,
    "n_t": 60
   },
   "label": "60 x 60 grid",
   "position": {
    "x": 40.0,
    "y": 210.0
   }
  },
  {
   "id": "eq_a001",
   "type": "equations.system",
   "params": {
    "template": "heat",
    "fields": [
     "u"
    ],
    "pdes": [
     "u_t = alpha*lap(u)"
    ],
    "conditions": [
     {
      "kind": "initial",
      "on": "t_min",
      "equation": "u = sin(pi*x)"
     },
     {
      "kind": "dirichlet",
      "on": "boundary",
      "equation": "u = 0"
     }
    ],
    "coefficients": {
     "alpha": 0.01
    },
    "exact": "exp(-alpha*pi**2*t)*sin(pi*x)"
   },
   "label": "equations (alpha = 0.01)",
   "position": {
    "x": 330.0,
    "y": 40.0
   }
  },
  {
   "id": "pinn_a001",
   "type": "train.pinn",
   "params": {
    "width": 64,
    "depth": 3,
    "adam_steps": 8000,
    "lbfgs_steps": 0,
    "lr": 0.001,
    "n_collocation": 4096,
    "seed": 7
   },
   "label": "PINN (alpha = 0.01)",
   "position": {
    "x": 330.0,
    "y": 210.0
   }
  },
  {
   "id": "val_a001",
