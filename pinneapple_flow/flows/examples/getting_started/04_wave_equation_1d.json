  },
  {
   "id": "eq_c1",
   "type": "equations.system",
   "params": {
    "template": "wave",
    "fields": [
     "u"
    ],
    "pdes": [
     "u_tt = c**2*lap(u)"
    ],
    "conditions": [
     {
      "kind": "initial",
      "on": "t_min",
      "equation": "u = sin(pi*x)"
     },
     {
      "kind": "initial",
      "on": "t_min",
      "equation": "u_t = 0"
     },
     {
      "kind": "dirichlet",
      "on": "boundary",
      "equation": "u = 0"
     }
    ],
    "coefficients": {
     "c": 1.0
    },
    "exact": "cos(c*pi*t)*sin(pi*x)"
   },
   "label": "equations (c = 1)",
   "position": {
    "x": 330.0,
    "y": 40.0
   }
  },
  {
   "id": "pinn_c1",
   "type": "train.pinn",
   "params": {
    "width": 128,
    "depth": 3,
    "adam_steps": 10000,
    "lbfgs_steps": 0,
    "lr": 0.0005,
    "n_collocation": 5000,
    "seed": 3
   },
   "label": "PINN (c = 1)",
   "position": {
    "x": 330.0,
    "y": 210.0
   }
  },
  {
   "id": "val_c1",
