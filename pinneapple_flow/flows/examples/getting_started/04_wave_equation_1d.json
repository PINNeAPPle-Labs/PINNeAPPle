{
 "schema": "pinneapple-flow/1",
 "id": "example.getting_started.04_wave_equation_1d",
 "name": "Wave equation 1-D: PINNs for three wave speeds",
 "description": "examples/getting_started/04_wave_equation_1d.py: u_tt = c^2 u_xx on [0, 1] x [0, 1], u(x, 0) = sin(pi x), u_t(x, 0) = 0, fixed ends, for c = 1, 2, 4; each PINN (3 x 128 tanh, 10000 Adam steps at lr 5e-4, 5000 collocation points, seed 3 as in the script) against u = sin(pi x) cos(c pi t) on a 60 x 60 grid. The script trains its own torch loop with a hard x(1 - x) boundary factor; here train.pinn enforces the ends as a penalty. Nothing committed: the script prints the relative L2 per c.",
 "nodes": [
  {
   "id": "geo",
   "type": "geometry.domain",
   "params": {
    "dimension": 1,
    "x_range": [
     0.0,
     1.0
    ],
    "y_range": [
     0,
     1
    ],
    "z_range": [
     0,
     1
    ],
    "time_dependent": true,
    "t_range": [
     0.0,
     1.0
    ]
   },
   "label": "string x time",
   "position": {
    "x": 40.0,
    "y": 40.0
   }
  },
  {
   "id": "mesh",
   "type": "geometry.mesh",
   "params": {
    "n": 60,
