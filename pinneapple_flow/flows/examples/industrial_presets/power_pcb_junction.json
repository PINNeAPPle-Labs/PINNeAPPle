{
 "schema": "pinneapple-flow/1",
 "id": "example.industrial_presets.power_pcb_junction",
 "name": "Industrial preset: power pcb junction",
 "description": "pinneapple_presets.load('power_pcb_junction').run() at its data-sheet inputs and the preset's own validation (examples/industrial_presets/power_pcb_junction), compared with the committed results/result.json.",
 "nodes": [
  {
   "id": "run",
   "type": "preset.run",
   "params": {
    "preset": "power_pcb_junction"
   },
   "label": "preset (solver)",
   "position": {
    "x": 40.0,
    "y": 40.0
   }
  },
  {
   "id": "val",
   "type": "preset.validate",
   "params": {
    "preset": "power_pcb_junction"
   },
   "label": "preset validation",
   "position": {
    "x": 40.0,
    "y": 210.0
   }
  },
  {
   "id": "compare",
   "type": "examples.compare",
   "params": {
    "example": "industrial_presets",
    "comparisons": [
     {
      "flow": "run.tj_max_c",
      "ref": "power_pcb_junction/results/result.json:outputs.tj_max_c"
     },
     {
      "flow": "run.tj_max_hot_c",
      "ref": "power_pcb_junction/results/result.json:outputs.tj_max_hot_c"
     },
     {
      "flow": "run.tj_mosfet_c",
      "ref": "power_pcb_junction/results/result.json:outputs.tj_mosfet_c"
     },
     {
      "flow": "run.board_max_c",
      "ref": "power_pcb_junction/results/result.json:outputs.board_max_c"
     },
     {
      "flow": "run.energy_balance",
      "ref": "power_pcb_junction/results/result.json:outputs.energy_balance",
      "atol": 1e-12
     },
     {
      "flow": "run.total_power",
      "ref": "power_pcb_junction/results/result.json:outputs.total_power"
     }
    ],
    "tolerance_source": "deterministic engineering solvers: 1e-6 relative; balance residuals (zero to machine precision) within 1e-12 absolute"
   },
   "label": "same numbers",
   "position": {
    "x": 330.0,
    "y": 40.0
   }
  }
 ],
 "edges": [
  {
   "source": "run",
