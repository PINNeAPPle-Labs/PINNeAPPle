{
 "schema": "pinneapple-flow/1",
 "id": "example.industrial_presets.water_distribution_network",
 "name": "Industrial preset: water distribution network",
 "description": "pinneapple_presets.load('water_distribution_network').run() at its data-sheet inputs and the preset's own validation (examples/industrial_presets/water_distribution_network), compared with the committed results/result.json.",
 "nodes": [
  {
   "id": "run",
   "type": "preset.run",
   "params": {
    "preset": "water_distribution_network"
   },
   "label": "preset (solver)",
   "position": {
    "x": 40.0,
    "y": 40.0
   }
  },
  {
   "id": "val",
   "type": "preset.validate",
   "params": {
    "preset": "water_distribution_network"
   },
   "label": "preset validation",
   "position": {
    "x": 40.0,
    "y": 210.0
   }
  },
  {
   "id": "compare",
   "type": "examples.compare",
   "params": {
    "example": "industrial_presets",
    "comparisons": [
     {
      "flow": "run.min_pressure",
      "ref": "water_distribution_network/results/result.json:outputs.min_pressure"
     },
     {
      "flow": "run.supply",
      "ref": "water_distribution_network/results/result.json:outputs.supply"
     },
     {
      "flow": "run.max_velocity",
      "ref": "water_distribution_network/results/result.json:outputs.max_velocity"
     },
     {
      "flow": "run.max_gradient",
      "ref": "water_distribution_network/results/result.json:outputs.max_gradient"
     },
     {
      "flow": "run.cost",
      "ref": "water_distribution_network/results/result.json:outputs.cost"
     },
     {
      "flow": "run.p_node3",
      "ref": "water_distribution_network/results/result.json:outputs.p_node3"
     },
     {
      "flow": "run.p_node6",
      "ref": "water_distribution_network/results/result.json:outputs.p_node6"
     },
     {
      "flow": "run.iterations",
      "ref": "water_distribution_network/results/result.json:outputs.iterations"
     },
     {
      "flow": "run.continuity_residual",
      "ref": "water_distribution_network/results/result.json:outputs.continuity_residual",
      "atol": 1e-12
     },
     {
      "flow": "run.energy_residual",
      "ref": "water_distribution_network/results/result.json:outputs.energy_residual",
      "atol": 1e-12
     },
     {
      "flow": "run.total_demand",
      "ref": "water_distribution_network/results/result.json:outputs.total_demand"
     }
    ],
    "tolerance_source": "deterministic engineering solvers: 1e-6 relative; balance residuals (zero to machine precision) within 1e-12 absolute"
   },
   "label": "same numbers",
   "position": {
    "x": 330.0,
    "y": 40.0
   }
  }
 ],
