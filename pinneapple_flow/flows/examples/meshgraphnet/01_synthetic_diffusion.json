{
 "schema": "pinneapple-flow/1",
 "id": "example-mgn-synthetic-diffusion",
 "name": "MeshGraphNet on synthetic diffusion (01)",
 "description": "A MeshGraphNet learns graph-Laplacian diffusion on 24 random Delaunay meshes of 150 points and rolls out 20 steps on 6 unseen meshes, against the frozen-initial-state baseline (examples/meshgraphnet/01_synthetic_diffusion.py).",
 "nodes": [
  {
   "id": "mgn",
   "type": "gnn.meshgraphnet",
   "params": {
    "n_train": 24,
    "n_test": 6,
    "n_points": 150,
    "steps": 2500,
    "rollout": 20,
    "hidden": 32,
    "message_passing": 4
   },
   "label": "MeshGraphNet",
   "position": {
    "x": 40.0,
    "y": 40.0
   }
  },
  {
   "id": "compare",
   "type": "examples.compare",
   "params": {
    "example": "meshgraphnet",
    "comparisons": [
     {
      "flow": "mgn.frozen_ic_baseline_rmse",
      "ref": "_out/synthetic_diffusion.json:frozen_ic_baseline_rmse"
     },
     {
      "flow": "mgn.rollout_rmse",
      "ref": "_out/synthetic_diffusion.json:rollout_rmse"
     },
     {
      "flow": "mgn.one_step_rmse",
      "ref": "_out/synthetic_diffusion.json:one_step_rmse"
     }
    ],
    "tolerance_source": "seeded meshes, baseline and training (1e-6 relative); the example states no tolerance, so a trained-network difference from CPU threads or float order shows as 'differs'"
   },
   "label": "Same numbers as examples/meshgraphnet",
   "position": {
    "x": 330.0,
    "y": 40.0
   }
  }
 ],
 "edges": [
  {
   "source": "mgn",
   "source_port": "metrics",
   "target": "compare",
   "target_port": "metrics",
   "id": "mgn.metrics->compare.metrics"
  }
 ],
 "meta": {
  "kind": "example",
  "example": "meshgraphnet",
  "domain": "neural operators",
  "scripts": [
   "01_synthetic_diffusion.py"
  ],
  "quick": {
   "mgn": {
    "steps": 300
   },
   "compare": {
    "comparisons": [
     {
      "flow": "mgn.frozen_ic_baseline_rmse",
      "ref": "_out/synthetic_diffusion.json:frozen_ic_baseline_rmse"
     }
    ]
   }
  }
 }
}
