{
 "schema": "pinneapple-flow/1",
 "id": "example.pinn_solver.03_compiler_burgers_1d",
 "name": "Burgers 1-D PINN against the Cole-Hopf solution",
 "description": "examples/pinn_solver/03_compiler_burgers_1d.py: u_t + u u_x = nu u_xx, nu = 0.01 / pi, on [-1, 1] x [0, 1], u(x, 0) = -sin(pi x), u = 0 at x = -1, 1; a 4 x 64 tanh PINN, 2500 Adam steps at lr 2e-3, 8192 collocation points. The script prints only the initial-condition MSE; the flow measures the whole field against the Cole-Hopf solution (and validate_pinn reports the initial-condition error). The script trains its own loop on compile_problem; here train.pinn trains the same problem. Nothing committed.",
 "nodes": [
  {
   "id": "geo",
   "type": "geometry.domain",
   "params": {
    "dimension": 1,
    "x_range": [
     -1.0,
     1.0
    ],
    "y_range": [
     0,
     1
    ],
    "z_range": [
     0,
     1
    ],
    "time_dependent": true,
    "t_range": [
     0.0,
     1.0
    ]
   },
   "label": "x in [-1, 1], t in [0, 1]",
   "position": {
    "x": 40.0,
    "y": 40.0
   }
  },
  {
   "id": "mesh",
   "type": "geometry.mesh",
   "params": {
    "n": 101,
    "n_t": 51
   },
   "label": "grid",
   "position": {
    "x": 40.0,
    "y": 210.0
   }
  },
  {
   "id": "eq_burgers",
   "type": "equations.system",
   "params": {
    "template": "burgers",
    "fields": [
     "u"
    ],
    "pdes": [
     "u_t + u*u_x = nu*u_xx"
    ],
    "conditions": [
     {
      "kind": "initial",
      "on": "t_min",
      "equation": "u = -sin(pi*x)"
     },
     {
      "kind": "dirichlet",
      "on": "boundary",
      "equation": "u = 0"
     }
    ],
    "coefficients": {
     "nu": 0.003183098861837907
    },
    "exact": "cole_hopf"
   },
   "label": "equations (Burgers)",
   "position": {
    "x": 330.0,
    "y": 40.0
   }
  },
  {
   "id": "pinn_burgers",
   "type": "train.pinn",
   "params": {
    "width": 64,
    "depth": 4,
    "adam_steps": 2500,
    "lbfgs_steps": 0,
    "lr": 0.002,
    "n_collocation": 8192,
    "seed": 0
   },
   "label": "PINN (Burgers)",
   "position": {
    "x": 330.0,
    "y": 210.0
   }
  },
  {
   "id": "val_burgers",
   "type": "validate.compare",
   "params": {
    "reference": "exact"
   },
   "label": "vs exact (Burgers)",
   "position": {
    "x": 330.0,
    "y": 380.0
   }
  }
 ],
 "edges": [
  {
   "source": "geo",
   "source_port": "geometry",
   "target": "mesh",
   "target_port": "geometry",
   "id": "geo.geometry->mesh.geometry"
  },
  {
   "source": "geo",
   "source_port": "geometry",
   "target": "eq_burgers",
   "target_port": "geometry",
   "id": "geo.geometry->eq_burgers.geometry"
  },
  {
   "source": "mesh",
   "source_port": "mesh",
   "target": "eq_burgers",
   "target_port": "mesh",
   "id": "mesh.mesh->eq_burgers.mesh"
  },
  {
   "source": "eq_burgers",
   "source_port": "problem",
   "target": "pinn_burgers",
   "target_port": "problem",
   "id": "eq_burgers.problem->pinn_burgers.problem"
  },
  {
   "source": "pinn_burgers",
   "source_port": "solution",
   "target": "val_burgers",
   "target_port": "candidates",
   "id": "pinn_burgers.solution->val_burgers.candidates"
  },
  {
   "source": "eq_burgers",
   "source_port": "problem",
   "target": "val_burgers",
   "target_port": "problem",
   "id": "eq_burgers.problem->val_burgers.problem"
  }
 ],
 "meta": {
  "kind": "example",
  "example": "pinn_solver",
  "domain": "PINN",
  "scripts": [
   "03_compiler_burgers_1d.py"
  ],
  "quick": {
   "pinn_burgers": {
    "adam_steps": 150,
    "n_collocation": 2048
   }
  }
 }
