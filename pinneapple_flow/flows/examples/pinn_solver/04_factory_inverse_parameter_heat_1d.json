{
 "schema": "pinneapple-flow/1",
 "id": "example.pinn_solver.04_factory_inverse_parameter_heat_1d",
 "name": "Inverse PINN: the diffusivity of a 1-D rod",
 "description": "examples/pinn_solver/04_factory_inverse_parameter_heat_1d.py: u_t = alpha u_xx on [0, 1] x [0, 1] with u(x, 0) = sin(pi x) and zero ends, true alpha = 0.15, initial guess 0.5; a 4 x 64 tanh inverse PINN, 2500 Adam steps at lr 2e-3, 6000 collocation points, 256 noise-free observations. The script samples its observations from the closed form at t = 0.5 and trains PINNFactory in its own loop; here they are 256 random nodes of the finite-difference solution (data.observe) and inverse.discover identifies alpha. Nothing committed: the script prints alpha_learned and rel_L2(t = 0.5).",
 "nodes": [
  {
   "id": "geo",
   "type": "geometry.domain",
   "params": {
    "dimension": 1,
    "x_range": [
     0.0,
     1.0
    ],
    "y_range": [
     0,
     1
    ],
    "z_range": [
     0,
     1
    ],
    "time_dependent": true,
    "t_range": [
     0.0,
     1.0
    ]
   },
   "label": "rod x time",
   "position": {
    "x": 40.0,
    "y": 40.0
   }
  },
  {
   "id": "mesh",
   "type": "geometry.mesh",
   "params": {
    "n": 101,
    "n_t": 41
   },
   "label": "grid",
   "position": {
    "x": 40.0,
    "y": 210.0
   }
  },
  {
   "id": "true_eq",
   "type": "equations.system",
   "params": {
    "template": "heat",
    "fields": [
     "u"
    ],
    "pdes": [
     "u_t = alpha*lap(u)"
    ],
    "conditions": [
     {
      "kind": "initial",
      "on": "t_min",
      "equation": "u = sin(pi*x)"
     },
     {
      "kind": "dirichlet",
      "on": "boundary",
      "equation": "u = 0"
     }
    ],
    "coefficients": {
     "alpha": 0.15
    },
    "exact": "exp(-alpha*pi**2*t)*sin(pi*x)"
   },
   "label": "heat, alpha = 0.15 (truth)",
   "position": {
    "x": 330.0,
    "y": 40.0
   }
  },
  {
   "id": "fd",
   "type": "solver.classical",
   "params": {
    "method": "fd"
   },
   "label": "finite differences",
   "position": {
    "x": 330.0,
    "y": 210.0
   }
  },
  {
   "id": "sensors",
   "type": "data.observe",
   "params": {
    "n_points": 256,
    "noise": 0.0,
    "seed": 5
   },
   "label": "256 observations",
   "position": {
    "x": 330.0,
    "y": 380.0
   }
  },
  {
   "id": "inv_eq",
   "type": "equations.system",
   "params": {
    "template": "heat",
    "fields": [
     "u"
    ],
    "pdes": [
     "u_t = alpha*lap(u)"
    ],
    "conditions": [
     {
      "kind": "initial",
      "on": "t_min",
      "equation": "u = sin(pi*x)"
     },
     {
      "kind": "dirichlet",
      "on": "boundary",
      "equation": "u = 0"
     }
    ],
    "coefficients": {},
    "unknowns": [
     "alpha"
    ],
    "exact": ""
   },
   "label": "heat, alpha unknown",
   "position": {
    "x": 620.0,
    "y": 40.0
   }
  },
  {
   "id": "discover",
   "type": "inverse.discover",
   "params": {
    "initial_guess": {
     "alpha": 0.5
    },
    "width": 64,
    "depth": 4,
    "adam_steps": 2500,
    "lbfgs_steps": 0,
    "lr": 0.002,
    "n_collocation": 6000,
    "seed": 0
   },
   "label": "inverse PINN",
   "position": {
    "x": 620.0,
    "y": 210.0
   }
  }
 ],
 "edges": [
  {
   "source": "geo",
   "source_port": "geometry",
   "target": "mesh",
   "target_port": "geometry",
   "id": "geo.geometry->mesh.geometry"
  },
  {
   "source": "geo",
   "source_port": "geometry",
   "target": "true_eq",
   "target_port": "geometry",
   "id": "geo.geometry->true_eq.geometry"
  },
  {
   "source": "mesh",
   "source_port": "mesh",
   "target": "true_eq",
   "target_port": "mesh",
   "id": "mesh.mesh->true_eq.mesh"
  },
  {
