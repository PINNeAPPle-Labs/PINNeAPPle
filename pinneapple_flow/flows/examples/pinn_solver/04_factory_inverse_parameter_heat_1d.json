   "source_port": "problem",
   "target": "sensors",
   "target_port": "problem",
   "id": "true_eq.problem->sensors.problem"
  },
  {
   "source": "geo",
   "source_port": "geometry",
   "target": "inv_eq",
   "target_port": "geometry",
   "id": "geo.geometry->inv_eq.geometry"
  },
  {
   "source": "mesh",
   "source_port": "mesh",
   "target": "inv_eq",
   "target_port": "mesh",
   "id": "mesh.mesh->inv_eq.mesh"
  },
  {
   "source": "inv_eq",
   "source_port": "problem",
   "target": "discover",
   "target_port": "problem",
   "id": "inv_eq.problem->discover.problem"
  },
  {
   "source": "sensors",
