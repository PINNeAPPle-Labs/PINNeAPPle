{
 "schema": "pinneapple-flow/1",
 "id": "example.science.mie_scattering",
 "name": "Science: mie scattering",
 "description": "pinneapple_science experiment em.mie_scattering in 3D at the committed resolution, every computed quantity against its cited reference (examples/science/electromagnetism/mie_scattering); compared with the committed result.json of each dimension.",
 "nodes": [
  {
   "id": "run_3d",
   "type": "science.run",
   "params": {
    "experiment": "em.mie_scattering",
    "dim": "3D",
    "quick": false
   },
   "label": "mie_scattering 3D",
   "position": {
    "x": 40.0,
    "y": 40.0
   }
  },
  {
   "id": "compare",
   "type": "examples.compare",
   "params": {
    "example": "science",
    "comparisons": [
     {
      "flow": "run_3d.rel_error[Q_sca, BHMIE sample]",
      "ref": "electromagnetism/mie_scattering/3D/result.json:comparisons.0.rel_error"
     },
     {
      "flow": "run_3d.rel_error[Q_back, BHMIE sample]",
      "ref": "electromagnetism/mie_scattering/3D/result.json:comparisons.1.rel_error"
     },
     {
      "flow": "run_3d.rel_error[Q_sca at x = 0.02 (Rayleigh)]",
      "ref": "electromagnetism/mie_scattering/3D/result.json:comparisons.2.rel_error"
     },
     {
      "flow": "run_3d.rel_error[optical theorem: 4 Re S(0) / x^2 (absorbing sphere)]",
      "ref": "electromagnetism/mie_scattering/3D/result.json:comparisons.3.rel_error"
     },
     {
      "flow": "run_3d.rel_error[Q_ext at x = 3000 (absorbing)]",
      "ref": "electromagnetism/mie_scattering/3D/result.json:comparisons.4.rel_error"
     }
    ],
    "tolerance_source": "deterministic numerics at the committed resolution: 1e-6 relative on each relative error"
   },
   "label": "same numbers",
   "position": {
    "x": 330.0,
    "y": 40.0
   }
  }
 ],
 "edges": [
  {
   "source": "run_3d",
   "source_port": "metrics",
   "target": "compare",
   "target_port": "metrics",
   "id": "run_3d.metrics->compare.metrics"
  }
 ],
 "meta": {
  "kind": "example",
  "example": "science",
  "domain": "science",
  "scripts": [
   "electromagnetism/mie_scattering/README.md"
  ],
  "quick": {
   "run_3d": {
    "quick": true
   },
   "compare": {
    "comparisons": [],
    "tolerance_source": "quick: reduced sizes, not the committed resolution"
   }
  }
 }
}
