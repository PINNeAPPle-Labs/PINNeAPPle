      "ref": "antennas/results/compact_range_2ghz/design_summary.json:cuts.V_hcut_ripple_pp_dB"
     },
     {
      "flow": "check.V_vcut_ripple_pp_dB",
      "ref": "antennas/results/compact_range_2ghz/design_summary.json:cuts.V_vcut_ripple_pp_dB"
     },
     {
      "flow": "check.H_hcut_taper_dB",
      "ref": "antennas/results/compact_range_2ghz/design_summary.json:cuts.H_hcut_taper_dB"
     }
