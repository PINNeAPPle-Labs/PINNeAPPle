{
 "schema": "pinneapple-flow/1",
 "id": "freecad-openfoam-sweep",
 "name": "FreeCAD -> OpenFOAM: sweep and surrogate",
 "description": "A Latin-hypercube sweep over the FreeCAD parameters of the pipe bend (bend radius and angle), one OpenFOAM process per case and resumable, then a surrogate of the total pressure drop chosen on validation data and measured on held-out cases.",
 "nodes": [
  {
   "id": "study",
   "type": "cfd.study",
   "params": {
    "study": "pipe_bend",
    "resolution": 10,
    "backend": "auto"
   },
   "position": {
    "x": 40,
    "y": 120
   },
   "label": ""
  },
  {
   "id": "sweep",
   "type": "cfd.sweep",
   "params": {
    "bounds": {
     "Rc": [
      20,
      80
     ],
     "angle": [
      45,
      180
     ]
    },
    "n": 12,
    "method": "lhs",
    "fixed": {
     "Re": 200
    },
    "parallel": 2,
    "seed": 0
   },
   "position": {
    "x": 340,
    "y": 120
   },
   "label": ""
  },
  {
   "id": "sur",
   "type": "cfd.surrogate",
   "params": {
    "inputs": [
     "Rc",
     "angle"
    ],
    "outputs": [
     "dp_total_pa"
    ],
    "test_frac": 0.25,
    "budget": 5
   },
   "position": {
    "x": 640,
    "y": 120
   },
   "label": ""
  }
 ],
 "edges": [
  {
   "source": "study",
   "source_port": "study",
   "target": "sweep",
   "target_port": "study",
   "id": "study.study->sweep.study"
  },
  {
   "source": "sweep",
   "source_port": "dataset",
   "target": "sur",
   "target_port": "dataset",
   "id": "sweep.dataset->sur.dataset"
  }
 ],
 "meta": {}
}
