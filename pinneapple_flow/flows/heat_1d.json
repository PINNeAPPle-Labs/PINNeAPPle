   "target_port": "mesh",
   "id": "mesh.mesh->eq.mesh"
  },
  {
   "source": "eq",
   "source_port": "problem",
   "target": "fd",
   "target_port": "problem",
   "id": "eq.problem->fd.problem"
  },
  {
   "source": "fd",
   "source_port": "solution",
   "target": "validate",
   "target_port": "candidates",
   "id": "fd.solution->validate.candidates"
  },
  {
   "source": "fd",
   "source_port": "solution",
   "target": "plot",
   "target_port": "solution",
   "id": "fd.solution->plot.solution"
  },
  {
   "source": "eq",
   "source_port": "problem",
   "target": "pinn",
   "target_port": "problem",
   "id": "eq.problem->pinn.problem"
  },
  {
   "source": "pinn",
   "source_port": "solution",
   "target": "validate",
   "target_port": "candidates",
   "id": "pinn.solution->validate.candidates"
  },
  {
   "source": "pinn",
   "source_port": "solution",
   "target": "plot",
   "target_port": "solution",
   "id": "pinn.solution->plot.solution"
  },
  {
   "source": "eq",
   "source_port": "problem",
   "target": "validate",
   "target_port": "problem",
   "id": "eq.problem->validate.problem"
  },
  {
   "source": "validate",
   "source_port": "metrics",
   "target": "lab",
   "target_port": "validation",
   "id": "validate.metrics->lab.validation"
  }
 ],
 "meta": {
  "kind": "reproduction"
 }
}