{
 "card": {
  "name": "airfoil_cst_rans_mlp",
  "description": "Ensemble of 5 MLPs (8 -> 96 -> 96 -> 96 -> 3, SiLU, bootstrap) mapping a 6-weight CST airfoil and the angle of attack to lift, drag and quarter-chord moment coefficients of a fully turbulent, incompressible 2-D RANS solution at Re = 4e6. The ensemble spread is returned as an uncertainty.",
  "task": "Airfoil aerodynamic coefficients (Cl, Cd, Cm) from shape and angle of attack, 2-D steady RANS",
  "version": "1.0.0",
  "inputs": [
   {
    "name": "T0",
    "unit": "-",
    "description": "CST thickness weight, leading edge"
   },
   {
    "name": "T1",
    "unit": "-",
    "description": "CST thickness weight, mid chord"
   },
   {
    "name": "T2",
    "unit": "-",
    "description": "CST thickness weight, aft"
   },
   {
    "name": "M0",
    "unit": "-",
    "description": "CST camber weight, front"
   },
   {
    "name": "M1",
    "unit": "-",
    "description": "CST camber weight, mid chord"
   },
   {
    "name": "M2",
    "unit": "-",
    "description": "CST camber weight, aft"
   },
   {
    "name": "alpha_deg",
    "unit": "deg",
    "description": "angle of attack"
   }
  ],
  "outputs": [
   {
    "name": "Cl",
    "unit": "-",
    "description": "lift coefficient (per unit span, chord 1)"
   },
   {
    "name": "Cd",
    "unit": "-",
    "description": "drag coefficient"
   },
   {
    "name": "Cm",
    "unit": "-",
    "description": "pitching-moment coefficient about c/4"
   }
  ],
  "validity_range": {
   "T0": [
    0.1,
    0.24
   ],
   "T1": [
    0.08,
    0.22
   ],
   "T2": [
    0.08,
    0.22
   ],
   "M0": [
    -0.03,
    0.08
   ],
   "M1": [
    -0.02,
    0.14
   ],
   "M2": [
    -0.04,
    0.12
   ],
   "alpha_deg": [
    -2.0,
    14.0
   ],
   "reynolds": 4000000.0,
   "mach": "incompressible",
   "geometry_family": "2nd-order Bernstein CST, upper = M + T, lower = M - T, trailing-edge thickness 0.25 % chord",
   "regime": "fully turbulent (k-omega SST), attached to mildly separated; deep stall (Cl swing > 0.1 over the last 500 iterations) was excluded from training"
  },
  "known_limitations": [
   "Drag at high lift reads ~14 % high on the campaign grid (20k cells) compared with finer grids/XFOIL; the surrogate inherits the solver's bias, it does not correct it.",
   "Not valid in deep stall, at other Reynolds numbers, compressible flow or outside the CST bounds.",
   "Accuracy is against the same solver and grid that generated the training data (interpolation error); the solver's own error against experiment is the larger term."
  ],
  "architecture": "MLPEnsemble",
  "equations": [
   "steady incompressible RANS, k-omega SST (OpenFOAM v1912 simpleFoam)"
  ],
  "training_config": {
   "epochs": 6000,
   "optimizer": "Adam lr 3e-3, cosine, weight decay 1e-6",
   "loss": "MSE on standardised (Cl, log Cd, Cm), weights (1, 2, 1)",
   "bootstrap": true,
   "train_runs": 386,
   "train_shapes": 91,
   "extra_verification_runs": 54,
   "script": "apps/aero_optimizer/tools/train_surrogate.py"
  },
  "data_lineage": {
