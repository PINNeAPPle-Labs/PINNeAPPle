    "name": "r_base_k_w",
    "unit": "K/W",
    "description": "thermal resistance, base to ambient air"
   },
   {
    "name": "pressure_drop_pa",
    "unit": "Pa",
    "description": "air-side pressure drop"
   },
   {
    "name": "r_base_upper95_k_w",
